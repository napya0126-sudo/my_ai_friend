TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: non-public supergroup id where only NSFW runs (e.g. -1001234567890)
# LEAVE EMPTY to allow erotic in the same 1:1 private chat.
#TELEGRAM_EROTIC_CHAT_ID=-1001234567890
OPENROUTER_API_KEY=your_openrouter_api_key_here
FAL_API_KEY=your_fal_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: override LLM models
# MODEL_NSFW=gryphe/mythomax-l2-13b
# MODEL_CHAT=claude-sonnet-4-6

# Optional: override fal.ai image models
# IMAGE_MODEL_SFW=fal-ai/flux/dev
# IMAGE_MODEL_NSFW=fal-ai/realistic-vision

# NovitaAI — NSFW 特化画像生成。設定すると erotic 画像を NovitaAI で生成する（推奨）。
# NOVITA_API_KEY=your_novita_api_key_here
# NOVITA_MODEL=epicrealism_naturalSinRC1VAE.safetensors
